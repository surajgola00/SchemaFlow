# ── LLM Provider ──────────────────────────────────────────────────────────────
# Set LLM_API_KEY to enable live extraction. Leave blank → Demo/Mock mode.
# Works with OpenAI, Gemini (openai-compat endpoint), Groq, OpenRouter, Ollama.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ── Search Provider ────────────────────────────────────────────────────────────
# Options: duckduckgo_html (no key needed), serper, brave, searxng
SEARCH_PROVIDER=duckduckgo_html
SEARCH_API_KEY=

# ── Crawler / Fetcher ─────────────────────────────────────────────────────────
USER_AGENT=SchemaFlow/2.0 (data-intelligence; +https://github.com/schemaflow)
MAX_PAGES_PER_RUN=50
MAX_RECORDS_PER_RUN=200
MAX_RUNTIME_SECONDS=300
PER_DOMAIN_RPS=1.0

# ── Concurrency ────────────────────────────────────────────────────────────────
MAX_CONCURRENT_RUNS=2

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./database.db

# ── Demo / Fixture Mode ───────────────────────────────────────────────────────
DEMO_REPLAY_SPEED=fast
# Options: fast (no delay), cinematic (400ms per event)
